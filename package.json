{
  "name": "file-sharing-app",
  "version": "1.0.0",
  "description": "Simple file sharing app using Express and Multer",
  "main": "Index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run dashboard\"",
    "server": "node Index.js",
    "dashboard": "streamlit run python/streamlit_app.py --server.headless true --server.port 8501"
  },
  "dependencies": {
    "express": "^4.18.4",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
